{
  "name": "grid-governor",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "migrate": "pnpm --filter @grid-governor/core migrate",
    "codegen": "pnpm --filter @grid-governor/core codegen"
  }
}
