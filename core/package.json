{
    "name": "@grid-governor/core",
    "private": true,
    "type": "module",
    "exports": {
        "./auth": "./src/auth.ts",
        "./config": "./src/config.ts",
        "./db/client": "./src/db/client.ts",
        "./db/types": "./src/db/types.ts",
        "./logging": "./src/logging/index.ts",
        "./testing/database": "./src/testing/database.ts"
    },
    "sideEffects": false,
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "lint": "eslint .",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "migrate": "node src/db/migrate-cli.ts",
        "codegen": "kysely-codegen --camel-case --out-file src/db/types.ts"
    },
    "dependencies": {
        "@better-auth/kysely-adapter": "^1.7.2",
        "better-auth": "^1.7.2",
        "kysely": "^0.29.5",
        "pg": "^8.23.0",
        "pino": "^10.4.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@jarsec/eslint-config": "catalog:",
        "@testcontainers/postgresql": "^12.2.0",
        "@types/node": "catalog:",
        "@types/pg": "^8.23.1",
        "eslint": "catalog:",
        "kysely-codegen": "^0.20.0",
        "postgres-interval": "^4.1.0",
        "typescript": "catalog:",
        "vitest": "^4.1.11"
    }
}
