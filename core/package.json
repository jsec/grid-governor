{
    "name": "@grid-governor/core",
    "private": true,
    "type": "module",
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "sideEffects": false,
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "build": "tsc",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "migrate": "tsx src/db/migrate-cli.ts",
        "codegen": "kysely-codegen --out-file src/db/types.ts"
    },
    "dependencies": {
        "@better-auth/kysely-adapter": "^1.7.2",
        "better-auth": "^1.7.2",
        "kysely": "^0.29.5",
        "pg": "^8.23.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@jarsec/eslint-config": "catalog:",
        "@types/node": "catalog:",
        "@types/pg": "^8.23.1",
        "eslint": "catalog:",
        "kysely-codegen": "^0.20.0",
        "postgres-interval": "^4.1.0",
        "tsx": "^4.21.0",
        "typescript": "catalog:"
    }
}
